<div class="toast" id="toast"></div>

<script>
// مدیریت باز و بسته شدن Bottom Sheet ها
function openSheet(id, serviceName) {
  const el = document.getElementById(id);
  if (!el) return;
  if (serviceName && document.getElementById('selectedServiceInput')) {
    document.getElementById('selectedServiceInput').value = serviceName;
  }
  el.classList.add('active');
  document.body.classList.add('modal-open');
}

function closeSheet(id) {
  const el = document.getElementById(id);
  if (!el) return;
  el.classList.remove('active');
  document.body.classList.remove('modal-open');
}

function closeSheetOnBg(e, el) {
  if (e.target === el) {
    el.classList.remove('active');
    document.body.classList.remove('modal-open');
  }
}

// جستجوی سریع از صفحه اصلی
function handleServiceSearch(e) {
  e.preventDefault();
  const val = document.getElementById('svc').value;
  openSheet('urgentSheet', val);
}

// ارسال فرم‌ها و نمایش پیام اپلیکیشنی
function submitAppForm(e, sheetId, msg) {
  e.preventDefault();
  closeSheet(sheetId);
  showToast(msg);
  e.target.reset();
}

// پیام Toast بالای صفحه
function showToast(text) {
  const t = document.getElementById('toast');
  t.innerText = text;
  t.classList.add('show');
  setTimeout(() => t.classList.remove('show'), 3200);
}

// کپی آدرس و کد پستی
function copyText(id) {
  const txt = document.getElementById(id).innerText;
  navigator.clipboard.writeText(txt).then(() => {
    showToast('کپی شد: ' + txt);
  });
}

// تغییر وضعیت تب فعال در نوار پایین
function setActiveTab(el) {
  document.querySelectorAll('.nav-tab').forEach(t => t.classList.remove('active'));
  el.classList.add('active');
}

// تغییر زبان و جهت صفحه
function setLanguage(lang, btn) {
  document.querySelectorAll('.lang-chip').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  document.documentElement.dir = (lang === 'fa' || lang === 'ar') ? 'rtl' : 'ltr';
  document.documentElement.lang = lang;
  showToast('زبان برنامه تغییر کرد: ' + btn.innerText);
}
</script>
